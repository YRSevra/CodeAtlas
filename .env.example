# PostgreSQL connection string for Prisma ORM
# Local Docker Compose default:
DATABASE_URL="postgresql://codeatlas:codeatlas_dev_password@localhost:5432/codeatlas?schema=public"
# Vercel / Managed PostgreSQL example (Neon, Supabase, Vercel Postgres):
# DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/codeatlas?sslmode=require"
# Note: On PgBouncer / pooled hosts, append &pgbouncer=true to DATABASE_URL for runtime queries
# and pass a non-pooled connection string when running `npx prisma migrate deploy`.

# Optional server-side GitHub Personal Access Token (no elevated scopes needed for public repos;
# increases rate limit from 60/hour to 5,000/hour). NEVER expose this to the browser.
GITHUB_TOKEN=""

# Application environment (auto-managed by Vercel in Preview and Production)
NODE_ENV="development"

# Public canonical application URL (set to your https://your-project.vercel.app domain in Vercel)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
